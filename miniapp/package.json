{
  "name": "gomoku-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "博弈五子棋",
  "scripts": {
    "dev": "taro build --type xhs --watch",
    "build": "taro build --type xhs",
    "check": "vue-tsc --noEmit",
    "build:h5": "vite build --config h5/vite.config.ts",
    "pack:h5": "pnpm build:h5 && python3 h5/pack.py"
  },
  "dependencies": {
    "@gomoku/branding": "workspace:*",
    "@gomoku/config": "workspace:*",
    "@gomoku/engine": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tarojs/cli": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-vue3": "4.2.1",
    "@tarojs/plugin-platform-xhs": "1.2.2",
    "@tarojs/vite-runner": "4.2.1",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/compiler-sfc": "^3.5.13",
    "typescript": "^5.8.0",
    "vite": "^4.5.5",
    "vue-tsc": "^2.2.0"
  }
}
