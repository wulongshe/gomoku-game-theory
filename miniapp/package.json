{
  "name": "gomoku-miniapp",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "博弈五子棋",
  "scripts": {
    "dev": "taro build --type xhs --watch",
    "build": "pnpm build:xhs && pnpm build:h5",
    "build:xhs": "taro build --type xhs",
    "build:h5": "vite build --config targets/h5/vite.config.ts",
    "pack:h5": "pnpm build:h5 && node targets/h5/scripts/pack.ts",
    "check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@gomoku/branding": "workspace:*",
    "@gomoku/config": "workspace:*",
    "@gomoku/engine": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tarojs/cli": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-vue3": "4.2.1",
    "@tarojs/plugin-platform-xhs": "1.2.2",
    "@tarojs/vite-runner": "4.2.1",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitejs/plugin-vue-jsx": "^3",
    "@vue/compiler-sfc": "^3.5.13",
    "fflate": "^0.8.3",
    "typescript": "^5.8.0",
    "vite": "^4.5.5",
    "vue-tsc": "^2.2.0"
  }
}
